---
import { site } from '../data/site';

const links = [
  { href: '#join', label: 'Join' },
  { href: '#story', label: 'Our story' },
  { href: '#hire', label: 'Hire the band' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      <span class="wordmark__name">Maine St. Andrew’s</span>
      <span class="wordmark__sub">Pipes &amp; Drums</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn site-header__cta" href="#join">
      <span class="cta-long">Come to a practice</span><span class="cta-short" aria-hidden="true">Visit us</span>
    </a>
  </div>
  <div class="site-header__ribbon" aria-hidden="true"></div>
</header>

<style lang="scss">
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(12 26 48 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    color: var(--c-paper);

    &__inner {
      display: flex;
      align-items: center;
      gap: var(--space-3) var(--space-5);
      min-block-size: var(--header-h);
    }

    &__ribbon {
      @include tartan-ribbon(6px, 0.45px);
    }

    &__cta {
      margin-inline-start: auto;
      white-space: nowrap;
      min-block-size: 2.5rem;
      padding: var(--space-2) var(--space-4);
      @include type('sm');

      @include up('lg') {
        margin-inline-start: 0;
      }

      .cta-short {
        display: none;
      }

      @include down('sm') {
        .cta-long {
          @include visually-hidden;
        }

        .cta-short {
          display: inline;
        }
      }
    }
  }

  .wordmark {
    display: grid;
    line-height: 1;
    color: inherit;
    text-decoration: none;

    &__name {
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 0.8rem + 1vw, 1.3rem);
      white-space: nowrap;
      color: var(--c-sky-300);
    }

    &__sub {
      margin-top: 0.2rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgb(248 245 239 / 0.8);
    }
  }

  .site-nav {
    display: none;
    margin-inline-start: auto;

    @include up('lg') {
      display: block;
    }

    ul {
      display: flex;
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      color: rgb(248 245 239 / 0.85);
      font-weight: 600;
      text-decoration: none;
      padding-block: var(--space-2);
      border-bottom: 2px solid transparent;

      &:hover {
        color: var(--c-white);
        border-color: var(--c-red-500);
      }
    }
  }
</style>

---
// Sticky "Come to a practice" bar for small screens. Hidden while the Join or
// Contact sections are on screen so it never covers the form.
---

<div class="mobile-cta" data-mobile-cta>
  <a class="btn" href="#join">Come to a practice</a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const targets = ['#join', '#contact']
    .map((id) => document.querySelector(id))
    .filter((el): el is Element => el !== null);

  if (bar && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
        bar.classList.toggle('is-hidden', visible.size > 0);
      },
      { threshold: 0.05 },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style lang="scss">
  .mobile-cta {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: flex;
    padding: var(--space-3) var(--gutter) calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    background: rgb(12 26 48 / 0.94);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgb(169 203 239 / 0.2);
    transition:
      transform 220ms ease,
      opacity 220ms ease;

    .btn {
      flex: 1;
    }

    &:global(.is-hidden) {
      transform: translateY(100%);
      opacity: 0;
      pointer-events: none;
    }

    @include reduced-motion {
      transition: none;
    }

    @include up('md') {
      display: none;
    }
  }

  // Keep the footer clear of the bar on small screens.
  @include down('md') {
    :global(body) {
      padding-bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
    }
  }
</style>

---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__tartan" aria-hidden="true"></div>
  <div class="container site-footer__inner">
    <div class="site-footer__nap">
      <p class="site-footer__name">{site.name}</p>
      <p>{site.city}</p>
    </div>
    <div>
      <p class="site-footer__label">Rehearsals</p>
      <p>
        {site.rehearsal.days}, {site.rehearsal.time}<br />
        {site.rehearsal.place}, {site.rehearsal.city}
      </p>
    </div>
    <div>
      <p class="site-footer__label">Follow along</p>
      <p>
        <a href={site.facebookUrl} rel="noopener" target="_blank">Facebook</a> ·
        <a href={site.flickrUrl} rel="noopener" target="_blank">Photos on Flickr</a>
      </p>
    </div>
  </div>
  <div class="container site-footer__legal">
    <p>© {year} {site.name} · Est. {site.founded}</p>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    background: var(--c-water-900);
    color: rgb(248 245 239 / 0.8);
    @include type('sm');

    &__tartan {
      @include tartan(1px);
      block-size: 3.5rem;
      box-shadow: inset 0 -8px 12px -8px rgb(0 0 0 / 0.5);
    }

    &__inner {
      display: grid;
      gap: var(--space-6);
      padding-block: var(--space-7) var(--space-6);

      @include up('md') {
        grid-template-columns: 2fr 1.5fr 1fr;
      }
    }

    &__name {
      font-family: var(--font-display);
      font-size: 1.35rem;
      color: var(--c-sky-300);
      margin-block-end: var(--space-2);
    }

    &__label {
      margin-block-end: var(--space-1);
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--c-white);
      font-size: 0.72rem;
    }

    &__legal {
      padding-block: var(--space-4) var(--space-6);
      border-block-start: 1px solid rgb(169 203 239 / 0.15);

      p {
        margin: 0;
      }
    }

    a {
      color: var(--c-sky-300);
    }
  }
</style>

{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/index.php", "destination": "/", "type": 301 },
      { "source": "/ourband.php", "destination": "/#story", "type": 301 },
      { "source": "/contact.php", "destination": "/#contact", "type": 301 },
      { "source": "/schedule.php", "destination": "/", "type": 301 },
      { "source": "/roster.php", "destination": "/#story", "type": 301 },
      { "source": "/gallery.php", "destination": "/", "type": 301 },
      { "source": "/videos.php", "destination": "/", "type": 301 },
      { "source": "/links.php", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
